{
    // Sets the logging level.
    // Valid values are "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL".
    "log_level": "ERROR",

    // Agent used for new conversations.
    "provider": "codex",
    "providers": {
        // Codex connects to an existing app-server. A local server can be
        // started with: codex app-server --listen ws://127.0.0.1:4500
        "codex": {
            "app_server": {
                "url": "ws://127.0.0.1:4500",
                // Optional environment variable containing a gateway bearer token.
                "bearer_token_env": "",
                "allow_insecure_ws": false,
                "tls_verify": true,
                "connect_timeout_seconds": 10,
                "request_timeout_seconds": 60,
                "ping_interval_seconds": 25,
                "max_message_bytes": 8388608,
                "minimum_codex_version": "0.141.0",
                "reconnect_max_attempts": 5,
                "reconnect_base_delay_seconds": 1.0,
                // Optional fields added to every outbound app-server request.
                // For example: "request_fields": {"trace_id": "123123"}
                "request_fields": {}
            }
        },
        "pi": {
            "enabled": true,
            "cli_path": ""
        }
    },

    // Local workspace tools exposed to every configured app-server address.
    "local_tools": {
        "enabled": ["pwd", "list", "stat", "read", "search", "write", "create"],
        "auto_approve": ["pwd", "list", "stat", "read", "search"],
        "always_confirm": ["write", "create"],
        "denied_globs": [
            ".env", ".env.*", "**/.env", "**/.env.*",
            ".ssh/**", "**/.ssh/**", ".aws/**", "**/.aws/**",
            "*credentials*", "**/*credentials*", "*secret*",
            "**/*secret*", ".git/**", "**/.git/**"
        ],
        "max_read_bytes": 1048576,
        "max_output_bytes": 1048576
    },

    // List of tools to completely disable for the agents.
    "disable_ask_user": true,

    // Whether to share all open workspace folders with the agent.
    // If true, the agent can access files in all folders currently open in the workspace.
    // If false, the agent only has access to the agent working directory(cwd).
    "share_workspace_folders": true,

    // How markdown tables are rendered in the chat view.
    //   "bordered" — draw tables with horizontal border lines and
    //                space-aligned columns:
    //
    //     | Name | Qty |            ──────────────
    //     | ---- | --- |             Name     Qty
    //     | foo  | 1   |    ==>     ──────────────
    //     | bar  | 2   |             foo      1
    //                               ──────────────
    //                                bar      2
    //                               ──────────────
    //
    //   "markdown" — keep tables in their original markdown form
    //                (aligned, but with "|" pipe separators).
    "table_style": "bordered",

    // Keep Echo in a full-height pane at the far right.
    // When true, files you open will not remain in the chat's pane.
    "dedicated_chat_pane": true,

    // Optional local Codex data-directory hint used by Artifact filtering.
    // This is never sent to app-server. Do not place secrets here.
    // Example: "env": {"CODEX_HOME": "/path/to/.codex"}
    "env": {}
}
